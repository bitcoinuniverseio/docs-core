---
/*
 * The support matrix: every marketplace protocol against every marketplace
 * action, rendered from the registry snapshot at build time.
 *
 * Two columns are wide (protocol, availability) and thirteen are narrow. The
 * narrow cells carry a word, not a tick, so the table reads correctly with a
 * screen reader and without colour.
 */
import {
  marketplaceProtocols,
  ACTIONS,
  ACTION_LABELS,
  AVAILABILITY,
  slugFor,
  supportedActions,
} from '../data/registry.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = marketplaceProtocols.map((p) => ({
  protocol: p,
  supported: supportedActions(p),
}));
---

<div class="table-scroll matrix-scroll" tabindex="0" role="region" aria-label="Marketplace protocol support matrix, scrollable table">
  <table class="matrix">
    <caption class="sr-only">
      Every marketplace protocol in the Core registry, its chain, its
      availability, and whether each of the thirteen marketplace actions is
      supported. Yes means Core can execute the action for that protocol. No
      means it cannot; the protocol's own page gives the registry's stated
      reason.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="col-protocol">Protocol</th>
        <th scope="col">Chain</th>
        <th scope="col">Availability</th>
        {ACTIONS.map((a) => (
          <th scope="col" class="col-action"><span>{ACTION_LABELS[a]}</span></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(({ protocol, supported }) => {
        const availability = AVAILABILITY[protocol.marketplace.availability];
        return (
          <tr>
            <th scope="row" class="col-protocol">
              <a href={`${base}/protocols/detail/${slugFor(protocol.id)}/`}>
                {protocol.displayName}
              </a>
              <code class="pid">{protocol.id}</code>
            </th>
            <td class="mono">{protocol.chain}</td>
            <td>
              <span class={`chip chip-${availability.tone === 'live' ? 'live' : 'stale'}`}>
                {availability.label}
              </span>
              {protocol.marketplace.featureGate && (
                <code class="gate">{protocol.marketplace.featureGate}</code>
              )}
            </td>
            {ACTIONS.map((a) => (
              <td class={supported.has(a) ? 'yes' : 'no'}>{supported.has(a) ? 'Yes' : 'No'}</td>
            ))}
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  .matrix-scroll {
    /* The matrix is 16 columns wide by design. It gets the full width the
     * reader's window allows rather than the prose measure. */
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
    max-width: calc(100% + 2 * var(--sl-content-pad-x, 1rem));
  }

  table.matrix {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    line-height: 1.3;
    margin: 0;
  }

  table.matrix th,
  table.matrix td {
    padding: 0.3rem 0.5rem;
    border-bottom: 1px solid var(--bu-grid);
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }

  table.matrix thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bu-surface-raised);
    border-bottom: 2px solid var(--bu-grid-strong);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bu-muted);
    vertical-align: bottom;
  }

  /* The thirteen action columns are narrow. Rotating the header keeps the
   * matrix readable on a laptop instead of forcing a horizontal scroll for
   * the header text alone. */
  th.col-action {
    height: 7.5rem;
    width: 1.9rem;
    padding: 0.3rem 0;
    text-align: center;
  }

  th.col-action span {
    display: block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin: 0 auto;
    max-height: 7rem;
  }

  th.col-protocol {
    background: var(--bu-surface-raised);
    font-weight: 600;
    min-width: 12rem;
  }

  tbody th.col-protocol {
    position: sticky;
    left: 0;
    z-index: 1;
    border-right: 1px solid var(--bu-grid-strong);
  }

  .pid {
    display: block;
    font-family: var(--bu-font-mono);
    font-size: 0.66rem;
    color: var(--bu-muted);
    background: none;
    border: 0;
    padding: 0;
  }

  .gate {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--bu-font-mono);
    font-size: 0.66rem;
    color: var(--bu-stale-text);
    background: none;
    border: 0;
    padding: 0;
  }

  .mono {
    font-family: var(--bu-font-mono);
    font-size: 0.72rem;
    color: var(--bu-muted);
  }

  td.yes,
  td.no {
    text-align: center;
    font-family: var(--bu-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding-inline: 0;
  }

  td.yes {
    color: var(--bu-signal-text);
    background: var(--bu-signal-dim);
  }

  td.no {
    color: var(--bu-muted);
  }

  tbody tr:hover td,
  tbody tr:hover th {
    outline: 1px solid var(--bu-grid-strong);
    outline-offset: -1px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 50rem) {
    .matrix-scroll {
      margin-inline: 0;
      max-width: 100%;
    }
  }
</style>

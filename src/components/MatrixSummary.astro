---
/*
 * The matrix in six numbers, so a reader gets the shape of it before working
 * through 29 rows. Every figure is computed from the snapshot.
 */
import {
  ACTIONS,
  availabilityCounts,
  actionSupportCount,
  marketplaceProtocols,
} from '../data/registry.mjs';

const tally = availabilityCounts();
const enforcedFreshness = marketplaceProtocols.filter((p) => p.freshness.enforced);
const autoReorg = marketplaceProtocols.filter((p) => p.reorg.automaticReconciliation).length;
const settleAtOne = marketplaceProtocols.filter(
  (p) => p.confirmation.settlementMinConfirmations === 1,
).length;
const sellSupport = actionSupportCount('sell');
---

<dl class="readout">
  <div>
    <dt>Enabled</dt>
    <dd>{tally.enabled ?? 0}</dd>
    <span class="readout-note">Switched on in the shipped build.</span>
  </div>
  <div>
    <dt>Feature-gated</dt>
    <dd>{(tally['feature-gated'] ?? 0) + (tally['feature-gated-testnet-only'] ?? 0)}</dd>
    <span class="readout-note">
      Implemented, switched off unless an operator enables the gate. One of
      those is confined to testnet.
    </span>
  </div>
  <div>
    <dt>Read-only</dt>
    <dd>{tally['read-only'] ?? 0}</dd>
    <span class="readout-note">You can see them. You cannot trade them.</span>
  </div>
  <div>
    <dt>Support buy</dt>
    <dd>{actionSupportCount('buy')}<span class="of">/{marketplaceProtocols.length}</span></dd>
    <span class="readout-note">List: {actionSupportCount('list')}. Delist: {actionSupportCount('unlist')}.</span>
  </div>
  <div>
    <dt>Support sell</dt>
    <dd>{sellSupport}<span class="of">/{marketplaceProtocols.length}</span></dd>
    <span class="readout-note">
      Not one. `sell` means an executable offer workflow, and none is deployed.
    </span>
  </div>
  <div>
    <dt>Enforce freshness</dt>
    <dd>{enforcedFreshness.length}<span class="of">/{marketplaceProtocols.length}</span></dd>
    <span class="readout-note">
      {enforcedFreshness.map((p) => p.displayName).join(' and ')}, and neither can trade.
      Freshness elsewhere is checked per mutation rather than against a numeric ceiling.
    </span>
  </div>
  <div>
    <dt>Reconcile after a reorg</dt>
    <dd>{autoReorg}<span class="of">/{marketplaceProtocols.length}</span></dd>
    <span class="readout-note">The other {marketplaceProtocols.length - autoReorg} have no local order state to roll back.</span>
  </div>
  <div>
    <dt>Settle at 1 confirmation</dt>
    <dd>{settleAtOne}<span class="of">/{marketplaceProtocols.length}</span></dd>
    <span class="readout-note">
      The default. Operators may configure a deeper requirement. No protocol
      sets a minimum confirmation depth for a listing.
    </span>
  </div>
  <div>
    <dt>Actions tracked</dt>
    <dd>{ACTIONS.length}</dd>
    <span class="readout-note">Per protocol, each either supported with a mode or unsupported with a reason.</span>
  </div>
</dl>

<style>
  dl.readout dt {
    font-family: var(--bu-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bu-muted);
  }

  dl.readout .of {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--bu-muted);
  }
</style>

{
  "name": "docs-core",
  "version": "1.0.0",
  "private": true,
  "description": "Public product documentation for Core, the Bitcoin Universe explorer, portfolio, activity, and marketplace application",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:copy": "node scripts/check-copy-rules.mjs",
    "check:public-safety": "node scripts/check-public-safety.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "check:registry": "node scripts/check-protocol-matrix.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:markdown": "markdownlint-cli2 \"src/content/**/*.{md,mdx}\" \"*.md\"",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "test": "npm run check:copy && npm run check:public-safety && npm run check:manifest && npm run check:openapi && npm run check:registry && npm run check:assets && npm run check:markdown"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.14.1",
    "sharp": "^0.34.4",
    "starlight-links-validator": "^0.18.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "markdownlint-cli2": "^0.19.0",
    "playwright": "^1.56.1",
    "wait-on": "^9.0.1"
  }
}
